rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net: default catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Identity and Attribute helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Standalone Validation Blueprints (Anti-Update-Gap Patterns)
    function isValidUser(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             data.name is string && data.name.size() <= 100 &&
             data.username is string && data.username.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             data.birthday is string && data.birthday.size() <= 20;
    }

    function isValidFriend(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 100 &&
             data.birthday is string && data.birthday.size() <= 20;
    }

    function isValidSentGift(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.friendId is string && data.friendId.size() <= 128 &&
             data.giftName is string && data.giftName.size() <= 200;
    }

    function isValidNotification(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.type is string && data.type.size() <= 50 &&
             data.title is string && data.title.size() <= 200 &&
             data.message is string && data.message.size() <= 500;
    }

    // Core Matching Collections
    
    // Users Profile Collection
    match /users/{userId} {
      // Any signed-in user can read profiles to search/handshake, but writes are private to owner
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
      
      // Friends & buddies added by this user (Private to owner)
      match /friends/{friendId} {
        allow read, write: if isOwner(userId);
      }
      
      // Historical sent gifts records (Private to owner)
      match /sent_gifts/{giftId} {
        allow read, write: if isOwner(userId);
      }
      
      // In-app notifications & alerts (Private to owner)
      match /notifications/{notifId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
