rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function canCreatePendingFriendRequest() {
      return isSignedIn()
        && request.resource.data.requestType == "friend_request"
        && request.resource.data.id == request.auth.uid
        && request.resource.data.incomingRequest == true
        && request.resource.data.connectedBack == false;
    }

    function canUpdateParticipantConnection() {
      return isSignedIn()
        && resource.data.requestType == "friend_request"
        && resource.data.id == request.auth.uid
        && request.resource.data.id == resource.data.id
        && request.resource.data.connectedBack == true;
    }

    function optionalString(data, key) {
      return !(key in data) || data[key] is string;
    }

    function validUserCreate(data) {
      return data.uid is string
        && data.username is string
        && data.email is string
        && data.name is string
        && optionalString(data, "phone")
        && optionalString(data, "whatsapp")
        && optionalString(data, "birthday")
        && optionalString(data, "avatar");
    }

    function validUserUpdate(data) {
      return (!('uid' in data) || data.uid is string)
        && optionalString(data, "username")
        && optionalString(data, "email")
        && optionalString(data, "name")
        && optionalString(data, "phone")
        && optionalString(data, "whatsapp")
        && optionalString(data, "birthday")
        && optionalString(data, "avatar");
    }

    function validNotificationCreate(data) {
      return data.senderUid is string
        && data.recipientUid is string
        && data.type is string
        && data.title is string
        && data.message is string
        && data.timestamp is string
        && data.isRead is bool;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isSignedIn();
      allow list: if isSignedIn()
        && request.query.limit is int
        && request.query.limit <= 100;
      allow create: if isOwner(userId)
        && validUserCreate(request.resource.data);
      allow update: if isOwner(userId)
        && (!('uid' in request.resource.data) || request.resource.data.uid == userId)
        && validUserUpdate(request.resource.data);
      allow delete: if isOwner(userId);

      match /friends/{friendId} {
        allow read: if isOwner(userId)
          || (isSignedIn() && resource.data.id == request.auth.uid);
        allow create: if isOwner(userId) || canCreatePendingFriendRequest();
        allow update: if isOwner(userId) || canUpdateParticipantConnection();
        allow delete: if isOwner(userId)
          || (isSignedIn() && resource.data.id == request.auth.uid);
      }

      match /sent_gifts/{giftId} {
        allow read, write: if isOwner(userId);
      }

      match /received_gifts/{giftId} {
        allow read, write: if isOwner(userId);
      }

      match /notifications/{notifId} {
        allow read: if isOwner(userId)
          || (isSignedIn() && resource.data.senderUid == request.auth.uid);
        allow create: if isOwner(userId)
          || (isSignedIn()
            && request.resource.data.recipientUid == userId
            && request.resource.data.senderUid == request.auth.uid
            && validNotificationCreate(request.resource.data));
        allow update, delete: if isOwner(userId);
      }
    }

    match /usernames/{username} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username;
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
