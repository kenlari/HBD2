rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Global reusable primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function optionalString(data, key, maxSize) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxSize);
    }

    // Entity validation blueprints
    function validUserCreate(data) {
      return (!('uid' in data) || data.uid == request.auth.uid)
        && (!('isAdmin' in data) || data.isAdmin == false);
    }

    function validUserUpdate(data) {
      return (!('uid' in data) || data.uid == request.auth.uid)
        && (!('isAdmin' in data) || data.isAdmin == false);
    }

    function canCreatePendingFriendRequest() {
      return isSignedIn()
        && request.resource.data.requestType == "friend_request"
        && request.resource.data.id == request.auth.uid
        && request.resource.data.incomingRequest == true
        && request.resource.data.connectedBack == false;
    }

    function canUpdateParticipantConnection() {
      return isSignedIn()
        && resource.data.requestType == "friend_request"
        && resource.data.id == request.auth.uid
        && request.resource.data.connectedBack == true;
    }

    function validFriendDoc(friendId, userId, data) {
      return (!('id' in data) || data.id == friendId);
    }

    function validGift(data) {
      return true;
    }

    // 1. User Profiles Collection
    match /users/{userId} {
      // Allow directory queries and milestone dashboard views safely
      allow read: if true;
      allow create: if isOwner(userId)
        && validUserCreate(request.resource.data);
      allow update: if isOwner(userId)
        && validUserUpdate(request.resource.data);
      allow delete: if isOwner(userId);

      // 2. Friends Subcollection
      match /friends/{friendId} {
        allow read: if isOwner(userId)
          || (isSignedIn() && resource.data.id == request.auth.uid);
        allow create: if (isOwner(userId) && validFriendDoc(friendId, userId, request.resource.data))
          || (friendId == request.auth.uid && canCreatePendingFriendRequest() && validFriendDoc(friendId, userId, request.resource.data));
        allow update: if (isOwner(userId) && validFriendDoc(friendId, userId, request.resource.data))
          || (friendId == request.auth.uid && canUpdateParticipantConnection() && validFriendDoc(friendId, userId, request.resource.data));
        allow delete: if isOwner(userId)
          || (isSignedIn() && resource.data.id == request.auth.uid);
      }

      // 3. Sent Gifts Subcollection
      match /sent_gifts/{giftId} {
        allow read, list: if isOwner(userId);
        allow create, update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // 4. Received Gifts Subcollection
      match /received_gifts/{giftId} {
        allow read, list: if isOwner(userId);
        allow create, update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // 5. Notifications Subcollection
      match /notifications/{notifId} {
        allow read: if isOwner(userId)
          || (isSignedIn() && resource.data.senderUid == request.auth.uid);
        allow create: if isOwner(userId)
          || (isSignedIn()
            && request.resource.data.recipientUid == userId
            && request.resource.data.senderUid == request.auth.uid);
        allow update, delete: if isOwner(userId);
      }
    }

    // 6. Lowercase Usernames lookup mapping (Reservation Index)
    match /usernames/{username} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && username is string && username.size() >= 3 && username.size() <= 64;
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
